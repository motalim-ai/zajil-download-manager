<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: rustls-platform-verifier's file (plain HTTP only to
  certificate revocation lists), with plain HTTP to this phone's own
  127.0.0.1 added, where the emulator test serves the update files through
  `adb reverse` (android/README.md). Written by the `debugNetworkConfig`
  task from the AAR itself; a release build keeps the AAR's file as it is.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/debug_network"
        tools:replace="android:networkSecurityConfig" />
</manifest>
