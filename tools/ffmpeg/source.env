# The FFmpeg source that every Zajil build of ffmpeg and ffprobe comes from
# (ADR-0009). Changing any line here is a new tools release.
FFMPEG_VERSION=8.1.3
FFMPEG_TARBALL=ffmpeg-8.1.3.tar.xz
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz
# SHA-256 of the official tarball. Empty until the first CI run has
# checked the release signature below and printed it; then it is pinned.
FFMPEG_SHA256=
# The FFmpeg release signing key (ffmpeg-devel@ffmpeg.org) that signs
# FFMPEG_URL.asc.
FFMPEG_SIGNING_KEY=FCF986EA15E6E293A5644F10B4322F04D67658D8
